# =========================================================================
# TỔ SÁCH - BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế của bạn: cp .env.example .env
# =========================================================================

# 1. Cơ sở dữ liệu PostgreSQL (Supabase hoặc PostgreSQL Local)
# Lưu ý: Nếu dùng Supabase Transaction Pooler (cổng 6543), thêm tham số pgbouncer=true&connection_limit=10&pool_timeout=20
DATABASE_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
DIRECT_URL="postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 2. JWT Authentication Secret (Bắt buộc tối thiểu 32 ký tự, KHÔNG để trống ở production)
# Tạo khóa ngẫu nhiên an toàn bằng lệnh: openssl rand -base64 48
JWT_SECRET=""

# 3. Google Gemini AI API (Dành cho Trợ lý Bán hàng Agentic AI Chatbot)
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 4. Email Service (Gửi mã OTP xác thực và hóa đơn đơn hàng qua Gmail SMTP)
# Lấy App Password tại: https://myaccount.google.com/apppasswords
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# 5. Upstash Redis (Tùy chọn: Quản lý Token Blacklist & Rate Limit phân tán)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 6. Elasticsearch 8.x (Tùy chọn: Tìm kiếm full-text nâng cao, hệ thống tự động fallback sang PostgreSQL unaccent)
ELASTICSEARCH_NODE=""
ELASTICSEARCH_API_KEY=""

# 7. Khóa bảo vệ API Cron Jobs (Hủy đơn hàng quá hạn 24h tự động)
CRON_SECRET=""

# 8. Cấu hình Domain Ứng dụng
NEXT_PUBLIC_APP_URL="http://localhost:3000"
